# Admin area hardening.

Options -Indexes

# Never expose the credential or log files, even if they end up in here.
<FilesMatch "\.(json|txt|log|bak)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
</IfModule>

# OPTIONAL EXTRA LAYER — a second password prompt from the web server itself.
# To enable: create a password file on the server with
#     htpasswd -c /path/above/webroot/.htpasswd yourname
# then uncomment these four lines and set the correct path.
#
# AuthType Basic
# AuthName "Basmat Al Mawared Admin"
# AuthUserFile /path/above/webroot/.htpasswd
# Require valid-user
